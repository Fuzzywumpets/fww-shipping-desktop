{
  "name": "fww-shipping-desktop",
  "version": "1.0.19",
  "description": "Fuzzywumpets Shipping — desktop app with background printing",
  "author": "Fuzzywumpets",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir",
    "test": "node --test \"test/**/*.test.js\"",
    "msix:tools": "npm ci --prefix build/msix",
    "msix:assets": "electron tools/msix/generate-assets.js",
    "msix:manifest": "node tools/msix/generate-manifest.js",
    "msix:manifest:store": "node tools/msix/generate-manifest.js --store",
    "msix:stage": "node tools/msix/stage-layout.js",
    "dist:msix": "npm run dist:dir && npm run msix:manifest && npm run msix:stage && node tools/msix/pack.js --dev",
    "dist:msix:store": "npm run dist:dir && npm run msix:manifest:store && npm run msix:stage && node tools/msix/pack.js --store",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.fuzzywumpets.shipping",
    "productName": "FWW Shipping",
    "copyright": "Copyright © 2026 Fuzzywumpets",
    "icon": "assets/icon.png",
    "publish": {
      "provider": "github",
      "owner": "fuzzyalex84",
      "repo": "fww-shipping-desktop",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "FWW-Shipping-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FWW Shipping",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "files": [
      "main.js",
      "update-channel.js",
      "fww-logsink.cjs",
      "preload.js",
      "print-manager.html",
      "auth.html",
      "assets/**"
    ]
  }
}
